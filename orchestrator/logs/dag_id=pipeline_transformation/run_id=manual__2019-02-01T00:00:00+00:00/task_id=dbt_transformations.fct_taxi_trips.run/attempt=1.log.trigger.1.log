(cast(service_type as string), '_dbt_utils_surrogate_key_null_') as string))) as trip_id,\n        pickup_location_id,\n        dropoff_location_id,\n        payment_type_id,\n        rate_code_id,\n        fare_amount,\n        tip_amount,\n        vendor_id,\n        pickup_datetime,\n        dropoff_datetime,\n        passenger_count,\n        trip_distance,\n        total_amount,\n        partition_date,\n        partition_key,\n        service_type\n\n    from yellow_taxi\n\n    union all\n\n    select  \n        to_hex(md5(cast(coalesce(cast(vendor_id as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(pickup_datetime as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(dropoff_datetime as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(passenger_count as string), '_dbt_utils_surrogate_key_null_') || '-' || coalesce(cast(service_type as string), '_dbt_utils_surrogate_key_null_') as string))) as trip_id,\n\n        pickup_location_id,\n        dropoff_location_id,\n        payment_type_id,\n        rate_code_id,\n        fare_amount,\n        tip_amount,\n        vendor_id,\n        pickup_datetime,\n        dropoff_datetime,\n        passenger_count,\n        trip_distance,\n        total_amount,\n        partition_date,\n        partition_key,\n        service_type\n        \n    from green_taxi\n)\n-- WE DONT NEED TO DEDUPLICATE HERE : IF OUR FCT_ DATA UNIQUE, AND INCOMING DATA HAS BEEN HANDLED IN STG_ AND IT IS UNIQUE, MERGE WILL ALWAYS WORKS.\n-- deduplicated as (\n\n--     select\n--         *,\n\n--     from combined_trips\n--     where \n--         -- 🟢 Identify duplicates: if two rows have identical vendor, pickup, and dropoff, \n--         -- the second one gets a row_num of 2.\n--         row_number() over (\n--             partition by vendor_id, pickup_datetime, dropoff_datetime, service_type,\n--             order by dropoff_datetime desc\n--         ) = 1\n\n-- ),\n\nselect * from combined_trips\n\n\n \n\n  where \n\n-- Restrict the incremental scan strictly to the YEAR Airflow is currently processing, if a row exists, update it.\n--  year_ingested = CAST('2020' AS INT64)\n\n-- Restrict the incremental scan strictly to >= +1 month OR <= +2 months of the Date Airflow is currently processing, if a row exists, update it.\n\n    dropoff_datetime >= DATE_SUB((select max(dropoff_datetime) from `elpipeline`.`ishak_tobbi_dataset`.`fct_taxi_trips`), INTERVAL 1 MONTH)\n    -- AND\n    -- pickup_datetime <= DATE_SUB((select max(pickup_datetime) from `elpipeline`.`ishak_tobbi_dataset`.`fct_taxi_trips`), INTERVAL 2 MONTH)\n   \n\n\n-- NOT USING IT : CHRONOLOGICAL FILTERING NOT USEFULL FOR DATA OUT OF ORDERS (2019 IN 2021, 0R 2021 IN 2019) SOME DATA LL BE LOST FOREVER.\n--  -- 🟢 Only scan and grab rows newer than the max date already in the warehouse\n--   where dropoff_datetime > coalesce(\n-- --     -- we check if already exists current dropoff year, if yes, we ingest data right after its bigest year\n--     (select max(dropoff_datetime) from `elpipeline`.`ishak_tobbi_dataset`.`fct_taxi_trips` \n--         where \n--             EXTRACT(year from dropoff_datetime) = CAST('2020' AS INT64)),\n-- --     -- if not, we select the min dropoff ear from our data = run year, and ingest from it.\n--     (select min(dropoff_datetime) from combined_trips where EXTRACT(year from dropoff_datetime) = CAST('2020' AS INT64)))"}>
