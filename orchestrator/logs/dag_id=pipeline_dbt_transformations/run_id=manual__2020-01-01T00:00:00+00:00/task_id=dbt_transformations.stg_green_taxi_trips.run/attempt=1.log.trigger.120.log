vement_surcharge as float64) as improvement_surcharge,\n        safe_cast(total_amount as float64) as total_amount,\n        safe_cast(congestion_surcharge as float64) as congestion_surcharge,\n\n        safe_cast('2020' as INT64) as year_ingested,\n        safe_cast('01' as INT64) as month_ingested,\n\n\n    from source\n\n)\n\nselect * from staged"}>
