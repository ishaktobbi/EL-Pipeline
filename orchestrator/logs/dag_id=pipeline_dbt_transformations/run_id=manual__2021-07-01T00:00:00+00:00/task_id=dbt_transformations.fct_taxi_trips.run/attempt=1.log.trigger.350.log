id,\n        dropoff_location_id,\n        payment_type_id,\n        rate_code_id,\n        fare_amount,\n        tip_amount,\n        vendor_id,\n        pickup_datetime,\n        dropoff_datetime,\n        passenger_count,\n        trip_distance,\n        total_amount,\n        partition_date,\n        partition_key,\n        \'yellow\' as service_type -- Tag the source for analysts\n    from yellow_taxi\n\n    union all\n\n    select  \n        to_hex(md5(cast(coalesce(cast(vendor_id as string), \'_dbt_utils_surrogate_key_null_\') || \'-\' || coalesce(cast(pickup_datetime as string), \'_dbt_utils_surrogate_key_null_\') || \'-\' || coalesce(cast(dropoff_datetime as string), \'_dbt_utils_surrogate_key_null_\') || \'-\' || coalesce(cast(passenger_count as string), \'_dbt_utils_surrogate_key_null_\') || \'-\' || coalesce(cast("green" as string), \'_dbt_utils_surrogate_key_null_\') as string))) as trip_id,\n\n        pickup_location_id,\n        dropoff_location_id,\n        payment_type_id,\n        rate_code_id,\n        fare_amount,\n        tip_amount,\n        vendor_id,\n        pickup_datetime,\n        dropoff_datetime,\n        passenger_count,\n        trip_distance,\n        total_amount,\n        partition_date,\n        partition_key,\n        \'green\' as service_type\n    from green_taxi\n)\n-- WE DONT NEED TO DEDUPLICATE HERE : IF OUR FCT_ DATA UNIQUE, AND INCOMING DATA HAS BEEN HANDLED IN STG_ AND IT IS UNIQUE, MERGE WILL ALWAYS WORKS.\n-- deduplicated as (\n\n--     select\n--         *,\n\n--     from combined_trips\n--     where \n--         -- 🟢 Identify duplicates: if two rows have identical vendor, pickup, and dropoff, \n--         -- the second one gets a row_num of 2.\n--         row_number() over (\n--             partition by vendor_id, pickup_datetime, dropoff_datetime, service_type,\n--             order by dropoff_datetime desc\n--         ) = 1\n\n-- ),\n\nselect * from combined_trips'}>
